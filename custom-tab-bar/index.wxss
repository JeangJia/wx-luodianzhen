/* custom-tab-bar/index.wxss —— 图标为内联 SVG 矢量图（data URI），无需图片文件 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: stretch;
  /* 显式声明 content-box：自定义组件默认不受 app.wxss 里 view{box-sizing:border-box} 影响，
     这里写清楚，保证总高恒为「100rpx + 安全区 + 1rpx 上边框」。
     各页面的底部操作栏按「100rpx + 安全区」让位，才能和它严丝合缝不留缝 */
  box-sizing: content-box;
  height: 100rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  border-top: 1rpx solid #ECE7DC;
  box-shadow: 0 -4rpx 20rpx rgba(38, 50, 56, 0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100rpx;
}

.tab-ico {
  width: 44rpx;
  height: 44rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 100% 100%;
}

.tab-txt {
  font-size: 20rpx;
  line-height: 1.2;
  margin-top: 6rpx;
  color: #6B7280;
}

.tab-item.on .tab-txt {
  color: #2E6E6B;
  font-weight: 600;
}

