/* pages/mine/mine.wxss */
.page {
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.head {
  display: flex;
  align-items: center;
  padding: 50rpx 32rpx 60rpx;
  background: #2E6E6B;
  color: #fff;
}

/* 头像：同样用空 button 做透明遮罩，保证视觉不受 button 内置样式影响 */
.avatar-wrap {
  position: relative;
  width: 130rpx;
  height: 130rpx;
  flex-shrink: 0;
}

.avatar-hit {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  opacity: 0;
}

.avatar-hit::after {
  border: none;
}

.avatar {
  width: 130rpx;
  height: 130rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}

.head-info {
  padding-left: 26rpx;
}

.nick-input {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.nick-ph {
  color: rgba(255, 255, 255, 0.75);
  font-size: 32rpx;
  font-weight: 400;
}

.head-sub {
  font-size: 23rpx;
  opacity: 0.85;
  margin-top: 10rpx;
}

/* ---------- 数据速览 ---------- */
.stats {
  margin-top: -34rpx;
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  position: relative;
  z-index: 2;
}

.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.2;
}

.stat-lbl {
  font-size: 21rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.stat-line {
  width: 2rpx;
  height: 50rpx;
  background: var(--line);
}

/* ---------- 卡片 ---------- */
.block {
  margin-top: 20rpx;
  padding: 26rpx 24rpx;
}

.block-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 700;
}

.block-more {
  font-size: 23rpx;
  color: var(--text-3);
}

/* ---------- 订单入口 ---------- */
.orders {
  display: flex;
  padding-top: 18rpx;
}

.order-entry {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.order-ico {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: var(--bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
}

.dot {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 17rpx;
  background: var(--primary);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-name {
  font-size: 23rpx;
  color: var(--text-2);
  margin-top: 12rpx;
}

/* ---------- 列表项 ---------- */
.cell {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.cell:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

/* 分享行：button 内部样式无法被页面 WXSS 覆盖，故只放一个空 button 做透明遮罩 */
.cell-share {
  position: relative;
  border-bottom: none;
  padding-bottom: 0;
}

.share-hit {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 0;
  opacity: 0;
}

.share-hit::after {
  border: none;
}

.cell-ico {
  font-size: 34rpx;
  margin-right: 20rpx;
}

.cell-name {
  font-size: 28rpx;
}

.cell-val {
  font-size: 23rpx;
  color: var(--text-3);
  margin-right: 10rpx;
}

.cell-arrow {
  font-size: 32rpx;
  color: #C6C2B8;
}

.footer {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-3);
  padding: 50rpx 0 20rpx;
}
