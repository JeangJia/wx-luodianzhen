<!--pages/index/index.wxml-->
<view class="page">

  <!-- 顶部红色区域 -->
  <view class="hero">
    <view class="hero-top">
      <view>
        <view class="hero-title">游罗店</view>
        <view class="hero-sub">罗店镇文旅导览 · 农产品直供平台</view>
      </view>
      <view class="hero-cart" bindtap="goCart">
        <text class="hero-cart-ico">🧺</text>
        <view class="badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
      </view>
    </view>

    <view class="search" bindtap="goSpotList">
      <text class="search-ico">🔍</text>
      <text class="search-ph">搜索景点 / 路线 / 农产品</text>
    </view>
  </view>

  <!-- 轮播 -->
  <swiper
    class="banner"
    autoplay
    circular
    interval="3000"
    duration="500"
    indicator-dots
    indicator-color="rgba(255,255,255,.45)"
    indicator-active-color="#ffffff"
  >
    <swiper-item wx:for="{{banners}}" wx:key="id">
      <view
        class="banner-item ph ph-{{item.theme}}"
        bindtap="onBannerTap"
        data-type="{{item.type}}"
        data-id="{{item.targetId}}"
      >
        <view class="banner-mask"></view>
        <view class="banner-emoji">{{item.emoji}}</view>
        <view class="banner-text">
          <view class="banner-t">{{item.title}}</view>
          <view class="banner-s">{{item.subtitle}}</view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- 实时资讯：上下滚动轮播 -->
  <view class="notice">
    <view class="notice-head">
      <view class="notice-ico"></view>
      <text class="notice-tag">实时资讯</text>
    </view>
    <swiper
      class="notice-swiper"
      vertical
      autoplay
      circular
      interval="3200"
      duration="500"
    >
      <swiper-item
        wx:for="{{notices}}"
        wx:key="id"
        bindtap="onNoticeTap"
        data-id="{{item.id}}"
      >
        <view class="notice-item">
          <text class="notice-txt ellipsis">{{item.text}}</text>
        </view>
      </swiper-item>
    </swiper>
    <view class="notice-more" bindtap="onNoticeMore">更多 ›</view>
  </view>

  <!-- 快捷入口 -->
  <view class="card entry-card">
    <view class="entry" wx:for="{{entries}}" wx:key="key" bindtap="onEntryTap" data-key="{{item.key}}">
      <view class="entry-ico">{{item.icon}}</view>
      <view class="entry-name">{{item.name}}</view>
    </view>
  </view>

  <!-- 数据速览 -->
  <view class="card stats">
    <view class="stat" bindtap="goSpotList">
      <view class="stat-num">{{stats.spot}}</view>
      <view class="stat-lbl">镇域及周边景点</view>
    </view>
    <view class="stat-line"></view>
    <view class="stat" bindtap="goRouteList">
      <view class="stat-num">{{stats.route}}</view>
      <view class="stat-lbl">精品旅游路线</view>
    </view>
    <view class="stat-line"></view>
    <view class="stat" bindtap="goProductList">
      <view class="stat-num">{{stats.product}}</view>
      <view class="stat-lbl">本地农产品</view>
    </view>
  </view>

  <!-- 热门景点 -->
  <view class="sec">
    <view class="sec-t">热门景点</view>
    <view class="sec-more" bindtap="goSpotList">查看全部 ›</view>
  </view>
  <scroll-view class="hscroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="hscroll-inner">
      <view
        class="spot-card card"
        wx:for="{{hotSpots}}"
        wx:key="id"
        bindtap="goSpotDetail"
        data-id="{{item.id}}"
      >
        <!-- 上半部分：底图 + 左上角特色图标 + 标题 -->
        <view class="spot-cover ph ph-{{item.theme}}">
          <view class="spot-cover-mask"></view>
          <view class="spot-badge">{{item.emoji}}</view>
          <view class="spot-cover-score">★ {{item.rating}}</view>
          <view class="spot-cover-text">
            <view class="spot-cover-t ellipsis-2">{{item.name}}</view>
            <view class="spot-cover-s ellipsis">{{item.tags[0]}}</view>
          </view>
        </view>

        <!-- 下半部分：编号特色列表 -->
        <view class="spot-body">
          <view
            class="spot-feature"
            wx:for="{{item.features}}"
            wx:for-item="feature"
            wx:for-index="fi"
            wx:key="*this"
          >
            <text class="spot-feature-no">0{{fi + 1}}</text>
            <text class="spot-feature-txt ellipsis">{{feature}}</text>
          </view>
          <view class="spot-more">查看更多 ›</view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 精选路线 -->
  <view class="sec">
    <view class="sec-t">精选路线</view>
    <view class="sec-more" bindtap="goRouteList">全部路线 ›</view>
  </view>
  <view class="wrap">
    <view
      class="route-card card"
      wx:for="{{hotRoutes}}"
      wx:key="id"
      bindtap="goRouteDetail"
      data-id="{{item.id}}"
    >
      <view class="route-cover ph ph-{{item.theme}}">{{item.emoji}}</view>
      <view class="route-body flex1">
        <view class="row between">
          <text class="route-name ellipsis">{{item.name}}</text>
          <text class="route-days">{{item.days}}日</text>
        </view>
        <view class="route-sum ellipsis-2">{{item.summary}}</view>
        <view class="row route-tags">
          <text class="tag tag-line" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        </view>
      </view>
    </view>

    <view class="plan-bar card" bindtap="goPlan">
      <view class="flex1">
        <view class="plan-t">不会安排行程？试试智能规划</view>
        <view class="plan-s">选择天数与偏好，一键生成专属行程</view>
      </view>
      <view class="btn btn-primary btn-sm">去规划</view>
    </view>
  </view>

  <!-- 农产品优选 -->
  <view class="sec">
    <view class="sec-t">农产品优选</view>
    <view class="sec-more" bindtap="goProductList">进入商城 ›</view>
  </view>
  <view class="wrap grid">
    <view
      class="goods card"
      wx:for="{{hotProducts}}"
      wx:key="id"
      bindtap="goProductDetail"
      data-id="{{item.id}}"
    >
      <view class="goods-cover ph ph-{{item.theme}}">{{item.emoji}}</view>
      <view class="goods-body">
        <view class="goods-name ellipsis">{{item.name}}</view>
        <view class="goods-tag ellipsis">{{item.tags[0]}}</view>
        <view class="row between goods-foot">
          <view class="price"><text class="price-sym">¥</text><text class="price-num">{{item.price}}</text></view>
          <text class="goods-unit">{{item.unit}}</text>
        </view>
      </view>
    </view>
  </view>

  <view class="footer">罗店镇文旅 · 农产品服务平台</view>
</view>
