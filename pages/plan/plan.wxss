/* pages/plan/plan.wxss */
.page {
  padding-bottom: 60rpx;
}

.intro {
  background: #2E6E6B;
  color: #fff;
  padding: 40rpx 32rpx 46rpx;
}

.intro-t {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.intro-s {
  font-size: 24rpx;
  opacity: 0.88;
  margin-top: 12rpx;
  line-height: 1.6;
}

.block {
  margin-top: 20rpx;
  padding: 28rpx 24rpx;
}

.step-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 22rpx;
}

.step-no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--primary);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.step-sub {
  font-size: 21rpx;
  color: var(--text-3);
  font-weight: 400;
  margin-left: 12rpx;
}

.opts .opt {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 16rpx;
  background: var(--bg);
  color: var(--text-2);
  font-size: 28rpx;
  margin-right: 18rpx;
}

.opts .opt:last-child {
  margin-right: 0;
}

.opt-on {
  background: var(--primary-soft) !important;
  color: var(--primary) !important;
  font-weight: 700;
  box-shadow: inset 0 0 0 2rpx var(--primary);
}

.pref-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.pref {
  width: 318rpx;
  height: 110rpx;
  border-radius: 16rpx;
  background: var(--bg);
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-bottom: 18rpx;
}

.pref-ico {
  font-size: 38rpx;
  margin-right: 14rpx;
}

.pref-name {
  font-size: 27rpx;
  color: var(--text-2);
}

.pref-on {
  background: var(--primary-soft);
  box-shadow: inset 0 0 0 2rpx var(--primary);
}

.pref-on .pref-name {
  color: var(--primary);
  font-weight: 700;
}

.group {
  display: flex;
  align-items: center;
  padding: 20rpx 22rpx;
  border-radius: 16rpx;
  background: var(--bg);
  margin-bottom: 16rpx;
}

.group:last-child {
  margin-bottom: 0;
}

.group-on {
  background: var(--primary-soft);
}

.group-radio {
  width: 38rpx;
  height: 38rpx;
  border-radius: 50%;
  background: #fff;
  border: 2rpx solid #DCD6C9;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.group-on .group-radio {
  border-color: var(--primary);
}

.group-radio-in {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: var(--primary);
}

.group-name {
  font-size: 28rpx;
  font-weight: 600;
}

.group-on .group-name {
  color: var(--primary);
}

.group-desc {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.actions {
  margin-top: 30rpx;
}

.actions .btn-plain-grey {
  margin-left: 20rpx;
}

/* ---------- 结果 ---------- */
.day {
  padding: 26rpx 24rpx 10rpx;
  margin-bottom: 20rpx;
}

.day-head {
  display: flex;
  align-items: center;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--line);
  margin-bottom: 8rpx;
}

.day-badge {
  width: 62rpx;
  height: 62rpx;
  border-radius: 16rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
  flex-shrink: 0;
}

.day-title {
  flex: 1;
  font-size: 29rpx;
  font-weight: 700;
}

.tl-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.tl-time {
  width: 96rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--primary);
}

.tl-card {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  padding: 14rpx;
  border-radius: 16rpx;
  background: var(--bg);
}

.tl-ico {
  width: 76rpx;
  height: 76rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  font-size: 38rpx;
}

.tl-name {
  font-size: 27rpx;
  font-weight: 600;
}

.tl-meta {
  font-size: 21rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.tl-nav {
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 24rpx;
  padding: 4rpx 18rpx;
  margin-left: 10rpx;
}

.footer {
  text-align: center;
  font-size: 21rpx;
  color: var(--text-3);
  padding: 40rpx 60rpx 20rpx;
  line-height: 1.6;
}
