/* pages/cart/cart.wxss */
.head-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 24rpx 16rpx;
}

.head-title {
  font-size: 26rpx;
  color: var(--text-2);
}

.head-clear {
  font-size: 24rpx;
  color: var(--text-3);
}

.item {
  display: flex;
  align-items: center;
  padding: 22rpx 20rpx;
  margin-bottom: 20rpx;
}

.check {
  padding-right: 18rpx;
}

.check-box {
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  border: 2rpx solid #DCD6C9;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

.check-on {
  background: var(--primary);
  border-color: var(--primary);
}

.item-ico {
  width: 150rpx;
  height: 150rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.item-body {
  padding-left: 22rpx;
}

.item-name {
  font-size: 29rpx;
  font-weight: 600;
  max-width: 300rpx;
}

.item-del {
  margin-left: 12rpx;
}

.item-spec {
  font-size: 22rpx;
  color: var(--text-3);
  background: var(--bg);
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
  display: inline-block;
  margin-top: 12rpx;
  max-width: 100%;
}

.item-foot {
  margin-top: 20rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: var(--bg);
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-dis {
  color: #C6C2B8;
}

.step-num {
  width: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
}

/* ---------- 底部结算 ---------- */
.check-all {
  display: flex;
  align-items: center;
  padding-right: 20rpx;
}

.check-all-txt {
  font-size: 26rpx;
  color: var(--text-2);
  margin-left: 14rpx;
}

.total {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  padding-right: 24rpx;
}

.total-lbl {
  font-size: 24rpx;
  color: var(--text-2);
  margin-right: 10rpx;
}

/* ---------- 空态 ---------- */
.empty .btn {
  height: 76rpx;
  font-size: 28rpx;
}
