/* pages/route/detail.wxss */
.head {
  position: relative;
  display: flex;
  align-items: center;
  padding: 46rpx 32rpx;
  overflow: hidden;
}

.head-bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

/* 压暗照片，保证白色标题可读 */
.head-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(110deg, rgba(18, 33, 32, 0.74) 0%, rgba(18, 33, 32, 0.44) 100%);
}

.head-emoji,
.head-info {
  position: relative;
  z-index: 1;
}

.head-emoji {
  font-size: 110rpx;
  line-height: 1;
}

.head-info {
  flex: 1;
  padding-left: 26rpx;
  color: #fff;
}

.head-name {
  font-size: 40rpx;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.head-tags {
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.head-tag {
  background: rgba(255, 255, 255, 0.24);
  color: #fff;
  margin-right: 12rpx;
}

.block {
  margin-top: 20rpx;
  padding: 26rpx 24rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.paragraph {
  font-size: 27rpx;
  color: var(--text-2);
  line-height: 1.85;
  text-align: justify;
  margin-bottom: 16rpx;
}

.meta-row {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
}

.meta-k {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--text-3);
}

.meta-v {
  font-size: 25rpx;
  color: var(--text-1);
  line-height: 1.6;
}

.route-tag {
  margin: 0 12rpx 8rpx 0;
}

/* ---------- 逐日行程 ---------- */
.day {
  padding: 26rpx 24rpx 10rpx;
  margin-bottom: 20rpx;
}

.day-head {
  display: flex;
  align-items: center;
  padding-bottom: 22rpx;
  border-bottom: 2rpx solid var(--line);
}

.day-badge {
  width: 62rpx;
  height: 62rpx;
  border-radius: 16rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 18rpx;
}

.day-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
}

.timeline {
  padding-top: 22rpx;
}

.tl-item {
  display: flex;
}

.tl-left {
  width: 40rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 10rpx;
}

.tl-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #DCD6C9;
  flex-shrink: 0;
}

.tl-dot-on {
  width: 20rpx;
  height: 20rpx;
  background: var(--primary);
  box-shadow: 0 0 0 6rpx var(--primary-soft);
}

.tl-line {
  flex: 1;
  width: 2rpx;
  background: var(--line);
  margin: 8rpx 0;
  min-height: 30rpx;
}

.tl-item:last-child .tl-line {
  background: transparent;
}

.tl-body {
  flex: 1;
  min-width: 0;
  padding: 0 0 30rpx 14rpx;
}

.tl-time {
  font-size: 23rpx;
  color: var(--primary);
  font-weight: 700;
}

.tl-title {
  font-size: 29rpx;
  font-weight: 600;
  margin-top: 6rpx;
}

.tl-note {
  font-size: 23rpx;
  color: var(--text-3);
  line-height: 1.6;
  margin-top: 6rpx;
}

.tl-spot {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 14rpx;
  border-radius: 16rpx;
  background: var(--bg);
}

.tl-spot-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  font-size: 36rpx;
}

.tl-spot-name {
  font-size: 26rpx;
  font-weight: 600;
}

.tl-spot-meta {
  font-size: 21rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.tl-nav {
  flex-shrink: 0;
  font-size: 23rpx;
  color: var(--primary);
  border: 2rpx solid var(--primary);
  border-radius: 24rpx;
  padding: 4rpx 20rpx;
  margin-left: 12rpx;
}

/* ---------- 好物 ---------- */
.goods-row {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  margin-bottom: 18rpx;
}

.goods-ico {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  font-size: 46rpx;
}

.goods-name {
  font-size: 27rpx;
  font-weight: 600;
}

.goods-desc {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.bar-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
}

.bar-ico {
  font-size: 34rpx;
  line-height: 1.2;
}

.bar-txt {
  font-size: 20rpx;
  color: var(--text-2);
}
