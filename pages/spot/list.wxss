/* pages/spot/list.wxss */
.search-wrap {
  position: sticky;
  top: 0;
  z-index: 10;
  background: var(--bg);
  padding: 20rpx 0 8rpx;
}

.search {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin: 0 24rpx;
  padding: 0 24rpx;
  border-radius: 38rpx;
  background: #fff;
  box-shadow: var(--shadow);
}

.search-ico {
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 27rpx;
}

.search-ph {
  color: var(--text-3);
  font-size: 26rpx;
}

.search-clear {
  margin-left: 16rpx;
}

.chips {
  margin-top: 18rpx;
  white-space: nowrap;
}

.chips-inner {
  display: inline-flex;
  padding: 0 24rpx;
}

.chip {
  flex-shrink: 0;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 30rpx;
  border-radius: 30rpx;
  background: #fff;
  color: var(--text-2);
  font-size: 26rpx;
  margin-right: 16rpx;
}

.chip-on {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

/* 用 margin 而不是 padding：.wrap 已经负责左右 24rpx 内边距，
   两者都用 padding 会互相覆盖，文字就会顶到屏幕左边 */
.count {
  font-size: 23rpx;
  color: var(--text-3);
  margin: 18rpx 0 14rpx;
}

/* 底部固定操作栏 + 自定义 TabBar 是叠在一起的，内容留白要同时让开两者 */
.page.has-bottom {
  padding-bottom: calc(250rpx + env(safe-area-inset-bottom));
}

.item {
  display: flex;
  padding: 22rpx;
  margin-bottom: 20rpx;
}

.item-cover {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  overflow: hidden;
  font-size: 76rpx;
}

.item-cover-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.item-body {
  padding-left: 22rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-name {
  font-size: 32rpx;
  font-weight: 700;
  max-width: 100%;
}

.item-tags {
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.item-tags .tag {
  margin: 0 10rpx 6rpx 0;
}

.item-meta {
  margin-top: 6rpx;
}

.item-town {
  font-size: 23rpx;
  color: var(--text-3);
  max-width: 280rpx;
}

.item-score {
  font-size: 23rpx;
  color: var(--gold-deep);
  font-weight: 600;
}

.item-score-ico {
  margin-right: 6rpx;
}

.item-foot {
  margin-top: 8rpx;
  padding-top: 10rpx;
  border-top: 2rpx solid var(--line);
}

.item-ticket {
  font-size: 23rpx;
  color: var(--primary);
  max-width: 240rpx;
}

.item-duration {
  font-size: 21rpx;
  color: var(--text-3);
}

.plan-tip {
  padding-left: 8rpx;
}

.plan-tip-t {
  font-size: 27rpx;
  font-weight: 600;
}

.plan-tip-s {
  font-size: 21rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

/* ---------- 底部规划条 ----------
 * 本页是 tabBar 页面，自定义 tabBar 占「100rpx + 安全区」且 z-index 更高，
 * 规划条要抬到它上面才不会被盖住；
 * bottom 里已经带了安全区，padding-bottom 就不能再算一次，否则底部多出一截
 * ------------------------------------------------------------ */
.bottom-bar {
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: 16rpx;
}
