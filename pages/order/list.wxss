/* pages/order/list.wxss */
.tabs {
  display: flex;
  align-items: center;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: var(--text-2);
  padding: 26rpx 0;
}

.tab-on {
  color: var(--primary);
  font-weight: 700;
}

/* 只占文字自身的宽度，供 JS 实测出下划线的尺寸 */
.tab-txt {
  display: inline-block;
}

/* 滑动下划线：left / width 由 JS 实测后写入，这里只负责样式与过渡 */
.tabs-line {
  position: absolute;
  left: 0;
  bottom: 0;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--primary);
}

/* 首次定位完成后再开启过渡，避免下划线从左侧“长”出来 */
.tabs-line-on {
  transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1),
              width 0.28s cubic-bezier(0.4, 0, 0.2, 1);
}

.order {
  margin-top: 20rpx;
  padding: 24rpx 22rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid var(--line);
}

.order-no {
  font-size: 22rpx;
  color: var(--text-3);
}

.order-status {
  font-size: 25rpx;
  font-weight: 700;
  color: var(--primary);
}

.status-done,
.status-cancelled {
  color: var(--text-3);
}

.order-goods {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.order-goods:last-of-type {
  border-bottom: none;
}

.g-ico {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.g-name {
  font-size: 27rpx;
  font-weight: 600;
}

.g-spec {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.g-right {
  text-align: right;
  flex-shrink: 0;
  padding-left: 16rpx;
}

.g-qty {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.order-info {
  border-top: 2rpx solid var(--line);
  background: var(--bg);
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-top: 18rpx;
}

.info-line {
  display: flex;
  align-items: flex-start;
  padding: 6rpx 0;
}

.info-k {
  width: 130rpx;
  flex-shrink: 0;
  font-size: 23rpx;
  color: var(--text-3);
}

.info-v {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
}

/* 改成纵向两行：上行合计金额、下行操作按钮，都靠右对齐，
   金额右边缘与最右侧按钮对齐 */
.order-foot {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  padding-top: 22rpx;
  margin-top: 10rpx;
  border-top: 2rpx solid var(--line);
}

.order-total {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  width: 100%;
  min-width: 0;
}

.total-k {
  font-size: 23rpx;
  color: var(--text-2);
  margin-right: 10rpx;
}

.acts {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: wrap;
}

.acts .btn {
  margin-left: 16rpx;
  margin-top: 16rpx;
}

.empty .btn {
  height: 76rpx;
  font-size: 28rpx;
}
