<!--pages/order/list.wxml-->
<view class="page">
  <view class="tabs">
    <view
      class="tab {{active === item.key ? 'tab-on' : ''}}"
      wx:for="{{tabs}}"
      wx:key="key"
      bindtap="onTabTap"
      data-key="{{item.key}}"
    >
      <view class="tab-txt">{{item.name}}</view>
    </view>
    <!-- 滑动下划线：宽度与文字同宽，切换时平移到选中项 -->
    <view
      class="tabs-line {{lineReady ? 'tabs-line-on' : ''}}"
      style="width: {{lineWidth}}px; transform: translateX({{lineLeft}}px);"
    ></view>
  </view>

  <view class="wrap">
    <view class="order card" wx:for="{{list}}" wx:key="id">
      <view class="order-head">
        <text class="order-no" bindtap="copyOrderId" data-id="{{item.id}}">订单号：{{item.id}}</text>
        <text class="order-status status-{{item.status}}">{{item.statusText}}</text>
      </view>

      <view class="order-goods" wx:for="{{item.items}}" wx:for-item="g" wx:key="key">
        <view class="g-ico ph ph-{{g.theme}} thumb">
          <image wx:if="{{g.cover}}" class="thumb-img" src="{{g.cover}}" mode="aspectFill" />
        </view>
        <view class="flex1">
          <view class="g-name ellipsis">{{g.name}}</view>
          <view class="g-spec ellipsis">{{g.spec}}</view>
        </view>
        <view class="g-right">
          <view class="price"><text class="price-sym">¥</text><text class="price-num">{{g.price}}</text></view>
          <view class="g-qty">×{{g.qty}}</view>
        </view>
      </view>

      <view class="order-info" bindtap="openAddressEdit" data-id="{{item.id}}">
        <view class="info-line">
          <text class="info-k">收货人</text>
          <text class="info-v flex1">{{item.address.name}} {{item.address.phone}}</text>
          <!-- 只有还没收货的订单能改 -->
          <text class="info-edit" wx:if="{{item.canEdit}}">修改 ›</text>
        </view>
        <view class="info-line">
          <text class="info-k">收货地址</text>
          <text class="info-v flex1">{{item.address.detail}}</text>
        </view>
        <view class="info-line" wx:if="{{item.remark}}">
          <text class="info-k">备注</text>
          <text class="info-v flex1">{{item.remark}}</text>
        </view>
        <view class="info-line">
          <text class="info-k">下单时间</text>
          <text class="info-v flex1">{{item.createdAt}}</text>
        </view>
      </view>

      <view class="order-foot">
        <view class="order-total">
          <text class="total-k">共 {{item.items.length}} 种商品 · 合计</text>
          <view class="price"><text class="price-sym">¥</text><text class="price-num">{{item.total}}</text></view>
        </view>
        <view class="acts">
          <view class="btn btn-plain-grey btn-sm" bindtap="callService">联系客服</view>
          <view
            class="btn btn-plain-grey btn-sm"
            wx:if="{{item.status === 'unpaid'}}"
            bindtap="cancel"
            data-id="{{item.id}}"
          >取消订单</view>
          <view
            class="btn btn-plain-grey btn-sm"
            wx:if="{{item.status === 'done' || item.status === 'cancelled'}}"
            bindtap="remove"
            data-id="{{item.id}}"
          >删除</view>
          <view
            class="btn btn-primary btn-sm"
            wx:if="{{item.status === 'unpaid'}}"
            bindtap="pay"
            data-id="{{item.id}}"
          >立即支付</view>
          <view
            class="btn btn-primary btn-sm"
            wx:if="{{item.status === 'paid'}}"
            bindtap="confirmReceive"
            data-id="{{item.id}}"
          >确认收货</view>
        </view>
      </view>
    </view>

    <view class="empty" wx:if="{{list.length === 0}}">
      <view class="ic ic-xl ic--package empty-icon"></view>
      <view>还没有相关订单</view>
      <view class="btn btn-primary" style="margin-top: 40rpx;" bindtap="goShopping">去逛逛农产品</view>
    </view>
  </view>

  <!-- 收货信息编辑弹层：用 wx:if 而不是只改透明度，
       否则隐藏时 textarea 这类原生组件可能还留在屏幕上 -->
  <block wx:if="{{editShow}}">
    <view class="sheet-mask" bindtap="closeAddressEdit"></view>
    <view class="sheet">
      <view class="sheet-head">
        <text class="sheet-title">修改收货信息</text>
        <view class="ic ic-sm ic--close" bindtap="closeAddressEdit"></view>
      </view>

      <view class="field">
        <text class="field-k">收货人</text>
        <input
          class="field-input"
          value="{{editName}}"
          data-field="editName"
          placeholder="请输入姓名"
          placeholder-class="field-ph"
          bindinput="onAddrInput"
        />
      </view>

      <view class="field">
        <text class="field-k">手机号</text>
        <input
          class="field-input"
          value="{{editPhone}}"
          data-field="editPhone"
          type="number"
          maxlength="11"
          placeholder="用于接收发货通知"
          placeholder-class="field-ph"
          bindinput="onAddrInput"
        />
      </view>

      <view class="field field-last">
        <text class="field-k">收货地址</text>
        <textarea
          class="field-textarea"
          value="{{editDetail}}"
          data-field="editDetail"
          placeholder="省 / 市 / 县 / 乡镇 / 详细地址"
          placeholder-class="field-ph"
          maxlength="120"
          auto-height
          bindinput="onAddrInput"
        />
      </view>

      <view class="sheet-ft">
        <view class="btn btn-primary sheet-save" bindtap="saveAddress">保存</view>
      </view>
    </view>
  </block>
</view>
