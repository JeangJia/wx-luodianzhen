<!--pages/product/detail.wxml-->
<view class="page has-bottom" wx:if="{{product}}">

  <!-- 封面 -->
  <view class="cover ph ph-{{product.theme}}">
    <image wx:if="{{product.cover}}" class="cover-img" src="{{product.cover}}" mode="aspectFill" />
  </view>

  <view class="wrap">
    <!-- 基本信息 -->
    <view class="card block">
      <view class="goods-price-row">
        <view class="price">
          <text class="price-sym">¥</text><text class="price-big">{{product.price}}</text>
          <text class="price-old" wx:if="{{product.originPrice}}">¥{{product.originPrice}}</text>
        </view>
        <text class="goods-sales">已售 {{product.sales}} · 库存 {{product.stock}}</text>
      </view>
      <view class="goods-name">{{product.name}}</view>
      <view class="row" style="flex-wrap: wrap; margin-top: 14rpx;">
        <text class="tag" wx:for="{{product.tags}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="origin-row">
        <view class="ic ic-sm ic--pin origin-ico"></view>
        <text class="origin-txt flex1">{{product.origin}}</text>
      </view>
    </view>

    <!-- 规格 -->
    <view class="card block">
      <view class="block-title">选择规格</view>
      <view class="specs">
        <view
          class="spec {{specIndex === index ? 'spec-on' : ''}}"
          wx:for="{{product.specs}}"
          wx:key="*this"
          data-index="{{index}}"
          bindtap="onSpecTap"
        >{{item}}</view>
      </view>

      <view class="qty-row">
        <text class="qty-lbl">购买数量</text>
        <view class="stepper">
          <view class="step-btn {{qty <= 1 ? 'step-dis' : ''}}" bindtap="minus">−</view>
          <view class="step-num">{{qty}}</view>
          <view class="step-btn" bindtap="plus">＋</view>
        </view>
      </view>
      <view class="qty-tip">单价 {{product.unit}}，下单后 48 小时内发货</view>
    </view>

    <!-- 卖点 -->
    <view class="card block">
      <view class="block-title">产品亮点</view>
      <view class="point" wx:for="{{product.highlights}}" wx:key="*this">
        <view class="ic ic-xs ic--diamond point-ico"></view>
        <text class="point-txt">{{item}}</text>
      </view>
    </view>

    <!-- 商品介绍 -->
    <view class="card block">
      <view class="block-title">商品介绍</view>
      <view class="paragraph">{{product.intro}}</view>
      <view class="para-item" wx:for="{{product.detail}}" wx:key="*this">
        <text class="para-dot">·</text>
        <text class="para-txt">{{item}}</text>
      </view>
    </view>

    <!-- 储存与配送 -->
    <view class="card block">
      <view class="block-title">储存与配送</view>
      <view class="info-row">
        <text class="info-k">储存方式</text>
        <text class="info-v flex1">{{product.storage}}</text>
      </view>
      <view class="info-row">
        <text class="info-k">发货说明</text>
        <text class="info-v flex1">{{product.delivery}}</text>
      </view>
      <view class="info-row">
        <text class="info-k">售后说明</text>
        <text class="info-v flex1">收到货品若有破损或品质问题，可联系客服协商补发或退款</text>
      </view>
    </view>

    <!-- 相关景点 -->
    <view class="sec">
      <view class="sec-t">这些地方可以买到</view>
    </view>
    <view class="spot-row card" wx:for="{{relatedSpots}}" wx:key="id" bindtap="goSpot" data-id="{{item.id}}">
      <view class="spot-ico ph ph-{{item.theme}} thumb">
        <image wx:if="{{item.cover}}" class="thumb-img" src="{{item.cover}}" mode="aspectFill" />
      </view>
      <view class="flex1">
        <view class="spot-name ellipsis">{{item.name}}</view>
        <view class="spot-town ellipsis">{{item.town}}</view>
      </view>
      <text class="spot-go">去看看 ›</text>
    </view>

    <!-- 推荐 -->
    <view class="sec">
      <view class="sec-t">同类推荐</view>
    </view>
    <view class="rec card" wx:for="{{recommend}}" wx:key="id" bindtap="goProduct" data-id="{{item.id}}">
      <view class="rec-ico ph ph-{{item.theme}} thumb">
        <image wx:if="{{item.cover}}" class="thumb-img" src="{{item.cover}}" mode="aspectFill" />
      </view>
      <view class="flex1">
        <view class="rec-name ellipsis">{{item.name}}</view>
        <view class="rec-tag ellipsis">{{item.tags[0]}}</view>
      </view>
      <view class="price"><text class="price-sym">¥</text><text class="price-num">{{item.price}}</text></view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="bottom-bar">
    <view class="bar-btn" bindtap="goCart">
      <view class="ic ic-sm ic--basket bar-ico"></view>
      <text class="bar-txt">购物车</text>
      <view class="badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
    </view>
    <view class="bar-btn" bindtap="callService">
      <view class="ic ic-sm ic--phone bar-ico"></view>
      <text class="bar-txt">客服</text>
    </view>
    <view class="btn btn-plain" bindtap="addToCart" style="margin-left: 12rpx;">加入购物车</view>
    <view class="btn btn-primary" bindtap="buyNow" style="margin-left: 16rpx;">立即购买</view>
  </view>
</view>
