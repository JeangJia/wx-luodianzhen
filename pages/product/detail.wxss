/* pages/product/detail.wxss */
.cover {
  position: relative;
  height: 520rpx;
  overflow: hidden;
}

.cover-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.cover-emoji {
  font-size: 220rpx;
  line-height: 1;
  opacity: 0.95;
}

.block {
  margin-top: 20rpx;
  padding: 26rpx 24rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}

.goods-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.price-big {
  font-size: 52rpx;
  font-weight: 700;
}

.goods-sales {
  font-size: 22rpx;
  color: var(--text-3);
}

.goods-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 12rpx;
  line-height: 1.4;
}

.origin-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid var(--line);
}

.origin-ico {
  font-size: 24rpx;
  margin-right: 10rpx;
}

.origin-txt {
  font-size: 24rpx;
  color: var(--text-2);
}

/* ---------- 规格 ---------- */
.specs {
  display: flex;
  flex-wrap: wrap;
}

.spec {
  padding: 14rpx 28rpx;
  border-radius: 14rpx;
  background: var(--bg);
  color: var(--text-2);
  font-size: 25rpx;
  margin: 0 18rpx 18rpx 0;
}

.spec-on {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 700;
  box-shadow: inset 0 0 0 2rpx var(--primary);
}

.qty-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 10rpx;
  border-top: 2rpx solid var(--line);
}

.qty-lbl {
  font-size: 26rpx;
  color: var(--text-2);
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  background: var(--bg);
  color: var(--text-1);
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-dis {
  color: #C6C2B8;
}

.step-num {
  width: 90rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.qty-tip {
  font-size: 21rpx;
  color: var(--text-3);
  margin-top: 14rpx;
}

/* ---------- 内容 ---------- */
.point {
  display: flex;
  align-items: flex-start;
  padding: 8rpx 0;
}

.point-ico {
  color: var(--primary);
  font-size: 24rpx;
  margin-right: 14rpx;
  line-height: 1.7;
}

.point-txt {
  flex: 1;
  font-size: 27rpx;
  line-height: 1.7;
}

.paragraph {
  font-size: 27rpx;
  color: var(--text-2);
  line-height: 1.85;
  text-align: justify;
}

.para-item {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
}

.para-dot {
  color: var(--primary);
  font-size: 30rpx;
  margin-right: 12rpx;
  line-height: 1.5;
}

.para-txt {
  flex: 1;
  font-size: 26rpx;
  color: var(--text-2);
  line-height: 1.7;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 12rpx 0;
  border-bottom: 2rpx solid var(--line);
}

.info-row:last-child {
  border-bottom: none;
}

.info-k {
  width: 140rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  color: var(--text-3);
}

.info-v {
  font-size: 25rpx;
  color: var(--text-1);
  line-height: 1.65;
}

/* ---------- 相关景点 / 推荐 ---------- */
.spot-row,
.rec {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  margin-bottom: 18rpx;
}

.spot-ico,
.rec-ico {
  width: 96rpx;
  height: 96rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
  font-size: 46rpx;
}

.spot-name,
.rec-name {
  font-size: 27rpx;
  font-weight: 600;
}

.spot-town,
.rec-tag {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 6rpx;
}

.spot-go {
  font-size: 23rpx;
  color: var(--primary);
}

/* ---------- 底部 ---------- */
.bar-btn {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100rpx;
}

.bar-ico {
  font-size: 34rpx;
  line-height: 1.2;
}

.bar-txt {
  font-size: 20rpx;
  color: var(--text-2);
}

.badge {
  position: absolute;
  top: -8rpx;
  right: 6rpx;
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 16rpx;
  background: var(--primary);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
